# Get keys from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_v3_api_key_here
TMDB_ACCESS_TOKEN=your_v4_read_access_token_here

# Default region for streaming availability
TMDB_DEFAULT_REGION=US

# Postgres (Neon free tier: https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here
# Local dev: http://localhost:3000 | Production: https://bingebox.life
AUTH_URL=http://localhost:3000
